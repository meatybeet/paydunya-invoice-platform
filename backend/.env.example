APP_NAME=PayDunya Invoice Platform
API_PREFIX=/api
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=paydunya_invoice_platform

# Used to create the first administrator automatically. Leave both blank to be
# prompted when starting the app from an interactive terminal.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-password
# Use a long, random value before deploying the application.
AUTH_SECRET=replace-with-a-long-random-secret

PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=your_master_key
PAYDUNYA_PRIVATE_KEY=your_private_key
PAYDUNYA_TOKEN=your_token
PAYDUNYA_STORE_NAME=Your Store Name
# These three URLs must be reachable from the internet over HTTPS in production.
# PayDunya will not call a localhost or plain HTTP address, so payments would
# stay pending forever. `python main.py --tunnel` replaces them at runtime with
# its temporary trycloudflare.com URL for local testing.
PAYDUNYA_CALLBACK_URL=http://localhost:8000/api/payments/callback
PAYDUNYA_RETURN_URL=http://localhost:8000/api/payments/success
PAYDUNYA_CANCEL_URL=http://localhost:8000/api/payments/cancel

# Public base URL of the frontend. Used to build the permanent invoice link that
# is printed inside every invoice, so it must be the address customers can open.
# The application serves the frontend folder from its own origin, so this is the
# same address as the API unless the static files are hosted elsewhere.
FRONTEND_URL=http://localhost:8000

# Leave empty when the frontend is served by this application (the standard
# setup). If you deliberately host the frontend on another domain, list only
# that exact browser origin here, separated by commas and without a trailing /.
# Example: CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# Where uploaded business and product images are stored. A relative path is
# resolved against the backend directory. Back this folder up: the files are not
# in the database.
UPLOAD_DIR=uploads
# Largest accepted image, in bytes. Default is 2 MB.
MAX_UPLOAD_BYTES=2097152

# Outgoing mail, used to send the invoice to the customer after a payment.
# Leave SMTP_HOST empty to disable emails: payments still work, only the email
# is skipped. With Gmail you must create an application password in your Google
# account (two-factor authentication required) and use it as SMTP_PASSWORD; your
# normal account password will be rejected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address the invoice is sent from, for example "DIALLO & FILS <no-reply@example.com>".
SMTP_FROM=
# Keep true for port 587. Set to false only if your provider requires it.
SMTP_STARTTLS=true
