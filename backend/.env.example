APP_NAME=PayDunya Invoice Platform
API_PREFIX=/api
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=paydunya_invoice_platform

# Used to create the first administrator automatically. Leave both blank to be
# prompted when starting the app from an interactive terminal.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-password
# Use a long, random value before deploying the application.
AUTH_SECRET=replace-with-a-long-random-secret

PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=your_master_key
PAYDUNYA_PRIVATE_KEY=your_private_key
PAYDUNYA_TOKEN=your_token
PAYDUNYA_STORE_NAME=Your Store Name
PAYDUNYA_CALLBACK_URL=http://localhost:8000/api/payments/callback
PAYDUNYA_RETURN_URL=http://localhost:8000/payment/success
PAYDUNYA_CANCEL_URL=http://localhost:8000/payment/cancel
